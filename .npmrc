# Enforce engines.node locally: `npm install` on a Node older than the
# declared floor fails immediately instead of warning. Without this the
# engines field is metadata only.
#
# The floor (22.23.1) is the latest Node 22.x security release at the
# time of pin; it ships the fixes for every known advisory affecting
# the 22.x line so far (see https://nodejs.org/en/blog/release/v22.23.1).
# Older patch releases (22.0.0 → 22.23.0) miss at least one of those
# fixes and we want to refuse them outright rather than warn on.
engine-strict=true
